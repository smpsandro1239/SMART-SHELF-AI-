# Local development defaults only. Never place real credentials here.
APP_ENV=development
APP_NAME=SMART SHELF AI
API_PORT=8000
POSTGRES_DB=smart_shelf
POSTGRES_USER=smart_shelf
POSTGRES_PASSWORD=change_me_for_local_development
DATABASE_URL=postgresql+psycopg://smart_shelf:change_me_for_local_development@db:5432/smart_shelf

# Authentication: generate a unique random secret before deployment.
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ACCESS_TOKEN_MINUTES=30
# Used only once to create the first administrator. Keep private.
BOOTSTRAP_ADMIN_KEY=replace_with_a_separate_random_secret

# Comma-separated origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:5173
IMAGE_STORAGE_PATH=/app/storage/shelf-images
MAX_IMAGE_UPLOAD_BYTES=10485760

# Optional Python provider factory (module:factory); blank disables image inference.
VISION_PROVIDER_FACTORY=app.demo.vision:create_provider
VISION_PROVIDER_MODE=mock
MOCK_VISION_DETECTION_LABEL=empty_facing

# Real ONNX provider: signed manifest + trusted Ed25519 public-key ring.
# Keep VISION_PROVIDER_MODE=mock until model weights and release trust are approved.
VISION_MODEL_MANIFEST_PATH=/models/manifest.json
# JSON map: {"release-key-2026":"<base64 raw 32-byte Ed25519 public key>"}
# Never put the signing private key in this file or in the runtime environment.
VISION_MODEL_TRUSTED_KEYS_JSON=
VISION_DETECTOR_MODEL_SHA256=
VISION_EMBEDDING_MODEL_SHA256=
