# Local development defaults only. Never place real credentials here.
APP_ENV=development
APP_NAME=SMART SHELF AI
API_PORT=8000
POSTGRES_DB=smart_shelf
POSTGRES_USER=smart_shelf
POSTGRES_PASSWORD=change_me_for_local_development
DATABASE_URL=postgresql+psycopg://smart_shelf:change_me_for_local_development@db:5432/smart_shelf

# Authentication: generate a unique random secret before deployment.
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ACCESS_TOKEN_MINUTES=30
# Used only once to create the first administrator. Keep private.
BOOTSTRAP_ADMIN_KEY=replace_with_a_separate_random_secret

# Comma-separated origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:5173
IMAGE_STORAGE_PATH=/app/storage/shelf-images
MAX_IMAGE_UPLOAD_BYTES=10485760
