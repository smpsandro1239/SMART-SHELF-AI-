# Optional local ONNX inference provider. Only enable real mode with licensed, validated model weights.
VISION_PROVIDER_MODE=real
VISION_PROVIDER_FACTORY=app.vision_onnx:create_provider
# Map the exact class IDs exported by this detector; these labels are not SKU IDs.
VISION_CLASS_LABELS_JSON={"0":"product","1":"empty_facing"}
# Only these semantic labels may produce SKU embeddings/matches.
VISION_SKU_MATCH_LABELS=product
VISION_MODELS_DIR=./models
VISION_DETECTOR_MODEL_PATH=/models/shelf-detector.onnx
# Required in real mode: inject the approved 64-character SHA-256 from trusted deployment configuration.
# VISION_DETECTOR_MODEL_SHA256=<64-character-approved-sha256>
# Optional: ONNX image-embedding model; omit to return UNKNOWN SKU matches.
VISION_EMBEDDING_MODEL_PATH=/models/product-embedder.onnx
# Required whenever VISION_EMBEDDING_MODEL_PATH is set.
# VISION_EMBEDDING_MODEL_SHA256=<64-character-approved-sha256>
VISION_MODEL_VERSION=shelf-onnx-v1
VISION_EMBEDDING_MODEL_VERSION=product-embedding-v1
VISION_INPUT_SIZE=640
VISION_CONFIDENCE_THRESHOLD=0.25
VISION_MAX_DETECTIONS=300
# Conservative SKU matching; calibrate with representative validation images.
PRODUCT_MATCHING_MIN_SIMILARITY=0.90
PRODUCT_MATCHING_MIN_MARGIN=0.05

# Optional OCR: install apps/api/requirements-ocr.txt and the compatible CPU PaddlePaddle runtime first.
# Leave empty to keep OCR disabled; visual inference still runs.
OCR_PROVIDER_FACTORY=app.ocr_paddle:create_provider
OCR_PROVIDER_NAME=paddleocr
OCR_MODEL_VERSION=PP-OCRv5-pt


# Stable database namespace shared by API/worker instances of this model deployment.
VISION_MODEL_DEPLOYMENT_ID=default
# Explicit key revocations take precedence even if a key is accidentally left in the trust map.
VISION_MODEL_REVOKED_KEY_IDS_JSON=[]
# Signed manifests require schema v2 and a positive, strictly increasing release version.
